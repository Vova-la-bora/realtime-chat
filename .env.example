# Скопируйте этот файл в .env: cp .env.example .env
# В паролях не используйте символы @ : / ? # — они ломают строку подключения.

# --- PostgreSQL ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat_dev_password
POSTGRES_DB=chat

# --- Бэкенд ---
# Секрет для подписи JWT. В продакшене — длинная случайная строка.
JWT_SECRET=change-me-to-a-long-random-string
# Origin фронтенда, которому разрешён CORS
CORS_ORIGIN=http://localhost:8080
# true, если сайт отдаётся по HTTPS (флаг Secure у refresh-cookie)
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Порты на хосте (раскомментируйте, если стандартные заняты, например локальным PostgreSQL) ---
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=3000   # первый инстанс бэкенда (api1)
# API2_PORT=3001  # второй инстанс бэкенда (api2)
# WEB_PORT=8080

# --- Для запуска бэкенда и тестов вне Docker (npm run dev / npm test) ---
DATABASE_URL=postgres://chat:chat_dev_password@localhost:5432/chat
TEST_DATABASE_URL=postgres://chat:chat_dev_password@localhost:5432/chat_test
